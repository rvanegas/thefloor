#!/bin/bash
#
# Archives the iOS app and uploads it to App Store Connect for TestFlight.
#
# Signing is automatic and cloud-managed: the distribution certificate and
# provisioning profile are created by Apple on first use and never appear in
# the local keychain, so `security find-identity` showing only a development
# certificate is expected and not a problem.
#
# DEVELOPMENT_TEAM has to be passed explicitly because `prebuild --clean`
# regenerates ios/ and drops it, leaving an archive that fails with "requires a
# development team".
set -euo pipefail

TEAM=${APPLE_TEAM_ID:-9946JKHZUJ}
WORKSPACE=app/ios/TheFloor.xcworkspace
SCHEME=TheFloor
ARCHIVE=/tmp/thefloor.xcarchive

cd "$(dirname "$0")/.."

# Every upload needs a build number Apple has not seen before, even when the
# version is unchanged. Bumping it here means one fewer thing to forget.
node - <<'JS'
const fs = require('fs');
const path = 'app/app.json';
const cfg = JSON.parse(fs.readFileSync(path, 'utf8'));
const next = String(Number(cfg.expo.ios.buildNumber || '0') + 1);
cfg.expo.ios.buildNumber = next;
fs.writeFileSync(path, JSON.stringify(cfg, null, 2) + '\n');
console.log(`→ build ${next}`);
JS

# --clean, deliberately. Without it, prebuild reuses the existing ios/ and a
# newly added native dependency can fail to be linked at all — which is how
# build 2 shipped without expo-document-picker, throwing at module scope and
# rendering the app as a black screen for every tester. Regenerating costs a
# couple of minutes; shipping an app that cannot start costs a build.
#
# DEVELOPMENT_TEAM is dropped by --clean and passed back explicitly below.
echo "→ prebuild"
(cd app && npx expo prebuild --platform ios --clean >/dev/null)

# Prebuild is not trusted to have done it: the failure being guarded against is
# silent, and a missing pod is only visible once testers see a black screen.
#
# The expected pods come from the autolinker rather than from guessing at
# package names — expo-status-bar is JS-only and has no pod at all, so a naive
# name-to-pod mapping fails every release for a module that was never meant to
# be there.
echo "→ checking native modules are linked"
(cd app && npx expo-modules-autolinking resolve --platform ios --json) \
  > /tmp/thefloor-autolink.json 2>/dev/null
node - <<'JS'
const fs = require('fs');
const lock = fs.readFileSync('app/ios/Podfile.lock', 'utf8');
const { modules } = JSON.parse(
  fs.readFileSync('/tmp/thefloor-autolink.json', 'utf8')
);
const expected = modules.flatMap((m) =>
  (m.pods ?? []).map((p) => ({ pod: p.podName, pkg: m.packageName }))
);
const missing = expected.filter(({ pod }) => !lock.includes(pod));
if (missing.length) {
  console.error('✗ autolinked but absent from Podfile.lock:');
  for (const { pod, pkg } of missing) console.error(`    ${pkg} → ${pod}`);
  console.error('  The archive would build and fail at launch. Stopping.');
  process.exit(1);
}
console.log(`  ${expected.length} native modules present in Podfile.lock`);
JS

echo "→ archive"
rm -rf "$ARCHIVE"
xcodebuild -workspace "$WORKSPACE" -scheme "$SCHEME" \
  -configuration Release -destination 'generic/platform=iOS' \
  -archivePath "$ARCHIVE" -allowProvisioningUpdates \
  DEVELOPMENT_TEAM="$TEAM" CODE_SIGN_STYLE=Automatic \
  archive >/tmp/thefloor-archive.log 2>&1 \
  || { echo "✗ archive failed; see /tmp/thefloor-archive.log" >&2; exit 1; }

echo "→ upload"
cat > /tmp/UploadOptions.plist <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>method</key><string>app-store-connect</string>
  <key>teamID</key><string>$TEAM</string>
  <key>signingStyle</key><string>automatic</string>
  <key>destination</key><string>upload</string>
  <key>uploadSymbols</key><true/>
</dict></plist>
PLIST

xcodebuild -exportArchive -archivePath "$ARCHIVE" \
  -exportPath /tmp/thefloor-upload \
  -exportOptionsPlist /tmp/UploadOptions.plist \
  -allowProvisioningUpdates 2>&1 | grep -E "Uploaded|EXPORT (SUCCEEDED|FAILED)|error:"

echo "✓ processing in App Store Connect — TestFlight in a few minutes"
