#!/bin/bash
#
# Prints every account's username and display name, for auth's display names.
#
#   ts export-display-names            the deployed server's, to stdout
#   ts export-display-names --local    the development database instead
#
# One `username<TAB>display name` per line, for accounts that have a username:
# the input dianoia-auth's `scripts/display_names.py` reads. Since 2026-11-09
# the display name is auth's (server/src/noesis.ts); this carries the names
# chosen here before then, once:
#
#   ts export-display-names > floor-display-names.tsv
#   on auth's box, display_names.py < floor-display-names.tsv, then --apply
#
# auth keeps a name it already has, so running it again changes nothing.
# Read-only. Tombstones (`erased:…`) have nobody behind them.
set -euo pipefail

HOST=${THEFLOOR_HOST:-ubuntu@44.241.121.49}
KEY=${THEFLOOR_KEY:-~/.ssh/lightsail-ubuntu}
REMOTE_DB=/home/ubuntu/thefloor-data/thefloor.db
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LOCAL_DB="$ROOT/server/thefloor.db"

local_mode=false

for arg in "$@"; do
  case "$arg" in
    --local) local_mode=true ;;
    -h|--help)
      awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
      exit 0
      ;;
    *) echo "Unknown option: $arg" >&2; exit 1 ;;
  esac
done

# Tabs and line breaks in a name would break the line it is on.
query="
SELECT lower(username) || char(9) || replace(replace(replace(display_name, char(9), ' '), char(10), ' '), char(13), ' ')
FROM accounts
WHERE username IS NOT NULL AND trim(display_name) != '' AND identifier NOT LIKE 'erased:%'
ORDER BY created_at, id;"

# Over stdin rather than interpolated into the remote shell, for ts db's reason.
if $local_mode; then
  [ -f "$LOCAL_DB" ] || { echo "No local database at $LOCAL_DB" >&2; exit 1; }
  sqlite3 -readonly -noheader -cmd '.timeout 2000' "$LOCAL_DB" <<<"$query"
else
  ssh -i "$KEY" -o BatchMode=yes "$HOST" \
    "sqlite3 -readonly -noheader -cmd '.timeout 2000' '$REMOTE_DB'" <<<"$query"
fi
