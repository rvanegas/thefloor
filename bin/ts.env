# Settings for technosophia's shared scripts (`ts`). Each script's --help
# says which it reads. The host is the ~/.ssh/config alias.
HOST=thefloor
URL=https://thefloor.rvanegas.co
DEPLOY_DEST=/home/ubuntu/thefloor
DEPLOY_STAMP=server/deployed.json
DEPLOY_LOG=thefloor-data/deploys.log
ENV_REMOTE=/home/ubuntu/thefloor/server/.env
ENV_EXAMPLE=server/.env.example
SERVICE=thefloor
DB_REMOTE=/home/ubuntu/thefloor-data/thefloor.db
DB_LOCAL=server/thefloor.db
WORKTREE_PACKAGES="core app server"
WORKTREE_COPY="app/.env"
NOTE_IGNORE="android-adaptive-icon"
APPLE_TEAM_ID=9946JKHZUJ
IOS_SCHEME=TheFloor
NOTES_PATHS="app core server"
AFTER_RELEASED="ts deploy-web --stable"
