#!/bin/bash
#
# Builds and runs the app on an Android emulator, and sets up the machine to be
# able to in the first place.
#
#     bin/android --setup     install the SDK pieces and create the AVD
#     bin/android             boot the AVD if it is cold, then `expo run:android`
#     bin/android --prebuild  regenerate android/ from app.json first
#     bin/android --apk       an APK on the Desktop, to send somebody else
#                             (APK_DEST=DIR to put it somewhere else)
#     bin/android --aab       build a signed App Bundle to upload to Play
#
# **Reach for `--prebuild` after any edit to `app.json`, and know why.**
# `expo run:android` regenerates `android/` only when it is *missing*. An
# existing one is left exactly as it is, so a changed `app.json` has no effect
# whatsoever on the next build and nothing says so — the build succeeds, the app
# installs, and it is the old configuration. That cost a round of confusion over
# `versionCode` on the first day this worked: the value was added, the build was
# clean, and the apk still carried the default.
#
# That applies to the emulator loop, where you are the only casualty. `--apk`
# and `--aab` do not wait to be asked: they hash `app.json`, compare it against
# the hash stamped into `android/` when that tree was generated, and prebuild
# themselves when the two differ. Those artifacts leave the machine, and a
# stale configuration on somebody else's phone is not a mistake you get to
# notice.
#
# This exists because the Android dev loop is four environment facts that no
# error message names. `expo run:android` on a machine missing any of them fails
# somewhere inside Gradle, in the register of a compiler problem rather than the
# missing install it is — the same shape as `bin/worktree-setup`'s
# `jest: command not found`, and for the same reason.
#
# The four:
#
# 1. **`ANDROID_HOME` is not set anywhere on this machine.** Android Studio
#    installs the SDK to ~/Library/Android/sdk and does not export it; nothing in
#    a shell profile does either. Gradle then cannot find `adb` or the platform.
#
# 2. **`JAVA_HOME` must point at a JDK 17, and every JDK already installed here
#    is too new.** This is the one that costs the afternoon. Android Studio ships
#    a bundled runtime, which is the obvious thing to point at and is **JDK 25**;
#    Homebrew's `openjdk` is **JDK 26**. Gradle 8.14.3 — what
#    `android/gradle/wrapper/gradle-wrapper.properties` pins — supports neither,
#    and what it says when handed one is a class-file-version error naming a jar,
#    not a sentence about Java versions. So this script pins the keg-only
#    `openjdk@17` and refuses to guess: a JDK on `PATH` is not evidence of a JDK
#    that works.
#
# 3. **The emulator zeroes out microphone input unless `-allow-host-audio` is
#    passed.** Not muted, not absent — *zeroes*, so the app publishes a track
#    that carries digital silence and everything else looks perfect. An audio
#    port debugged against that emulator is an audio port debugged against a
#    dead microphone. There is a second half to this that no flag fixes; see
#    `boot_emulator` below.
#
# 4. **The system image has to match the machine's architecture.** This is
#    arm64; an x86_64 image boots under emulation slowly enough to look hung.
#
# What this script deliberately does *not* do is ship anything. There is no
# Android release path — no `eas.json`, no signing key, no `bin/upload-android`
# — and `planning/ANDROID.md` says what each would cost. This is a development
# loop and nothing more.
set -euo pipefail

cd "$(dirname "$0")/.."

SDK="$HOME/Library/Android/sdk"
JDK17="/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home"
AVD=thefloor

# What `app.json` looked like when `android/` was last generated from it. Inside
# the generated tree, so that discarding the tree discards the claim.
STAMP=app/android/.app.json.sha256

# The API level is not a preference. `compileSdkVersion` comes from
# expo-modules-core's gradle plugin, which defaults to 36 — so the platform must
# be 36 whatever `platforms/` happens to already contain. This machine had
# android-37 and only android-37, which is the newer number and the wrong one.
API=36
IMAGE="system-images;android-$API;google_apis;arm64-v8a"

# `google_apis` rather than `google_apis_playstore`. Play images cannot be
# rooted, and nothing here wants the Play Store — but a rootable image is worth
# having the first time push or a permission needs poking at from `adb shell`.
PACKAGES=("platform-tools" "emulator" "platforms;android-$API" "$IMAGE")

CMDLINE_TOOLS_BUILD=15641748

say()  { echo "→ $*"; }
fail() { echo "✗ $*" >&2; exit 1; }

# ---------------------------------------------------------------------------

require_jdk17() {
  if [ ! -x "$JDK17/bin/java" ]; then
    fail "no JDK 17 at $JDK17
  Gradle 8.14.3 does not support the JDKs on this machine (Android Studio
  bundles 25, Homebrew's openjdk is 26). Install the one it does:
      brew install openjdk@17
  It is keg-only, so it does not go on PATH and does not displace anything —
  this script points JAVA_HOME straight at it."
  fi
  export JAVA_HOME="$JDK17"
}

require_sdk() {
  [ -d "$SDK" ] || fail "no Android SDK at $SDK — install Android Studio first"
  export ANDROID_HOME="$SDK"
  # Both names, because the ecosystem is split on which it reads: Gradle and the
  # Expo CLI want ANDROID_HOME, parts of the platform tooling want
  # ANDROID_SDK_ROOT, and neither warns when it falls back to the other.
  export ANDROID_SDK_ROOT="$SDK"
  export PATH="$SDK/platform-tools:$SDK/emulator:$SDK/cmdline-tools/latest/bin:$PATH"
}

# ---------------------------------------------------------------------------

setup() {
  require_sdk

  # cmdline-tools is the bootstrap and is itself absent from a stock Android
  # Studio install — `sdkmanager` lives inside it, so there is no SDK command to
  # install it with. Hence the download: it is the one package that cannot be
  # fetched the ordinary way.
  if [ ! -x "$SDK/cmdline-tools/latest/bin/sdkmanager" ]; then
    say "installing cmdline-tools (build $CMDLINE_TOOLS_BUILD)"
    local zip
    zip=$(mktemp -d)/cmdline-tools.zip
    curl -fL# -o "$zip" \
      "https://dl.google.com/android/repository/commandlinetools-mac-${CMDLINE_TOOLS_BUILD}_latest.zip"
    unzip -q "$zip" -d "$(dirname "$zip")"
    mkdir -p "$SDK/cmdline-tools"
    # The zip unpacks to a directory called `cmdline-tools`; the SDK expects it
    # at `cmdline-tools/latest`. Getting this wrong yields
    # `cmdline-tools/cmdline-tools`, which sdkmanager silently does not find.
    mv "$(dirname "$zip")/cmdline-tools" "$SDK/cmdline-tools/latest"
  fi

  require_jdk17

  say "accepting SDK licenses"
  # `pipefail` off for this one line, and it is not a shortcut. sdkmanager stops
  # reading once it has consumed the licenses it wanted, `yes` takes a SIGPIPE
  # for it, and the pipeline reports 141 — so under `set -euo pipefail` the
  # script exits **silently and successfully-looking** at exactly this point,
  # having installed nothing and created no AVD. It did, before this subshell.
  ( set +o pipefail; yes | sdkmanager --sdk_root="$SDK" --licenses >/dev/null )

  say "installing: ${PACKAGES[*]}"
  sdkmanager --sdk_root="$SDK" "${PACKAGES[@]}"

  if avdmanager list avd -c 2>/dev/null | grep -qx "$AVD"; then
    say "AVD '$AVD' already exists"
  else
    say "creating AVD '$AVD'"
    echo no | avdmanager create avd --name "$AVD" --package "$IMAGE" --device pixel_7
    # `hw.audioInput` is what lets the guest see a microphone at all. It defaults
    # on, but an AVD created without a device profile has been seen without it,
    # and a missing microphone presents as a permission the app never gets asked
    # for rather than as an error.
    local ini="$HOME/.android/avd/$AVD.avd/config.ini"
    if [ -f "$ini" ] && ! grep -q '^hw.audioInput=yes' "$ini"; then
      echo 'hw.audioInput=yes' >> "$ini"
    fi
  fi

  echo
  echo "✓ set up. Run: bin/android"
}

# ---------------------------------------------------------------------------

boot_emulator() {
  # An emulator already attached is left alone — rebooting one mid-session
  # throws away the app's signed-in state, which is several taps to get back.
  if adb devices | grep -q '^emulator-.*device$'; then
    say "emulator already running"
    return
  fi

  avdmanager list avd -c 2>/dev/null | grep -qx "$AVD" \
    || fail "no AVD named '$AVD' — run: bin/android --setup"

  say "booting '$AVD'"
  # Detached and discarded: the emulator outlives this script deliberately, so
  # that the next `bin/android` is the fast path above rather than another boot.
  emulator -avd "$AVD" -allow-host-audio >/dev/null 2>&1 &

  say "waiting for boot"
  adb wait-for-device
  # `wait-for-device` returns when adb can talk to it, which is well before the
  # system is up; installing an apk in that window fails as a device-offline
  # error that reads like a cable problem. `sys.boot_completed` is the honest
  # signal.
  until [ "$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = "1" ]; do
    sleep 2
  done
  say "booted"

  # The flag above is necessary and not sufficient, and the remaining half
  # cannot be scripted: the emulator's *runtime* microphone toggle lives in
  # Extended Controls → Microphone → "Virtual microphone uses host audio input",
  # it is off by default, and it resets on every boot. Without it the guest
  # microphone records silence exactly as if `-allow-host-audio` had been
  # omitted. Nobody hearing nothing from the emulator should touch the audio
  # code before checking that box.
  echo
  echo "  Audio note: to be heard from the emulator, turn on"
  echo "  Extended Controls (…) → Microphone → 'Virtual microphone uses host"
  echo "  audio input'. It is off by default and resets on every boot."
  echo
}

# **Prebuild when `android/` has drifted from `app.json`, without being asked.**
# The generated tree is regenerated by nothing on its own — the header says why
# — so an artifact built over a stale one carries the old configuration,
# succeeds, and says nothing about it. That is survivable in the emulator loop,
# where the next `--prebuild` fixes it and the only casualty is your own screen.
# It is not survivable for `--apk` or `--aab`: those leave the machine, and a
# versionCode is what a person reports back when something is wrong. On
# 2026-09-03 the tree said 137 and the apk path would have written 1.
#
# **The comparison is a hash of the whole file, and comparing version numbers
# instead is the version of this that looks sufficient and is not.** That was
# the first cut: `versionCode` and `version` move on nearly every build, so the
# check fires when it matters — but only if every `app.json` edit is
# accompanied by a version bump, and the case where it is not is precisely the
# Android one. An icon, a permission, a plugin setting, `orientation`: an
# Android-only change has no reason to touch `ios.buildNumber`, so nothing
# bumps `versionCode` with it, so a field-wise check sees a matching pair and a
# stale tree goes into the APK. Hashing costs the same and cannot be reasoned
# wrong.
#
# The stamp lives **inside** the generated tree deliberately. `--clean` wipes
# the directory, which takes the stamp with it, so a tree that was regenerated
# by any other route — or never generated at all, as in a fresh worktree — has
# no stamp and is treated as stale. There is no state to go out of sync with
# the thing it describes, because it is stored in it.
ensure_fresh() {
  local want have
  want=$(shasum -a 256 app/app.json | cut -d' ' -f1)
  have=$(cat "$STAMP" 2>/dev/null || true)
  [ "$want" = "$have" ] && return 0

  # Say which way it is stale when the version fields are the visible
  # difference, since that is the one somebody is about to go looking for, and
  # fall back to the honest general statement when it is anything else.
  local want_code has_code
  want_code=$(grep -oE '"versionCode":[[:space:]]*[0-9]+' app/app.json | grep -oE '[0-9]+' | head -1)
  has_code=$(grep -oE 'versionCode [0-9]+' app/android/app/build.gradle 2>/dev/null | head -1 | cut -d' ' -f2 || true)
  if [ -n "$has_code" ] && [ "$want_code" != "$has_code" ]; then
    say "android/ is stale (versionCode $has_code, app.json says $want_code)"
  else
    say "android/ is stale (app.json has changed since it was generated)"
  fi
  prebuild
}

apk() {
  require_sdk
  require_jdk17

  ensure_fresh

  say "building a release APK"
  # **Release rather than debug, and the difference is the whole point.** A
  # debug apk carries no JavaScript: it fetches the bundle from Metro on this
  # machine at launch, so it is unusable to anybody who is not on this LAN and
  # fails as a blank screen or a red one rather than as anything that names the
  # cause. A release build runs `createBundleReleaseJsAndAssets` and embeds it.
  #
  # **It is signed with the debug keystore**, which the Expo template configures
  # for `release` too — see `signingConfigs` in android/app/build.gradle. That is
  # fine for sideloading and is *not* a Play-store artifact: Google will not
  # accept an apk signed with the shared debug key, and a real upload key is one
  # of the things planning/ANDROID.md defers.
  #
  # `EXPO_PUBLIC_API_URL` is baked in from app/.env at bundle time, so whoever
  # installs this talks to whatever that file pointed at when it was built —
  # the deployed server, unless somebody has pointed it at a LAN address for
  # local work. Worth checking before sending the file to another person, since
  # nothing in the app says which server it is talking to.
  # **arm64 only, which is a choice and not a default.** `gradle.properties`
  # lists four architectures, and building all of them makes a 108MB apk —
  # awkward to send to a person and three-quarters wasted, since every Android
  # phone worth testing this on has been arm64 for close to a decade. The cost
  # is that the file will not install on a 32-bit armeabi-v7a device or an x86
  # emulator; if that is what somebody has, drop this flag and send the fat one.
  ( cd app/android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a )
  local out=app/android/app/build/outputs/apk/release/app-release.apk
  [ -f "$out" ] || fail "gradle reported success but $out is missing"

  # **Copied to the Desktop under a name that says what it is**, because the
  # only thing anybody does with this file is attach it to something. Gradle's
  # path is four directories deep inside a gitignored tree and its name is
  # `app-release.apk`, which is what every other Expo project on the machine
  # also produces — two of them in a downloads folder are indistinguishable, and
  # the one number that would tell them apart is the one the recipient quotes
  # back at you. Re-running for the same build overwrites in place, which is
  # what you want: the newer file is the one that should hold the name.
  # `APK_DEST` moves the destination for the odd case where the Desktop is
  # not where you want it; there is no flag, because a flag would be a third
  # thing to remember about a script whose point is that there is nothing to
  # remember.
  local code dest
  code=$(grep -oE 'versionCode [0-9]+' app/android/app/build.gradle | head -1 | cut -d' ' -f2)
  dest="${APK_DEST:-$HOME/Desktop}/thefloor-${code}.apk"
  cp "$out" "$dest"

  echo
  echo "✓ $dest"
  echo "  $(du -h "$dest" | cut -f1), versionCode $code, arm64-v8a only, debug-signed"
  # Printed rather than left to be remembered: nothing in the app says which
  # server it is talking to, and a copy built while app/.env pointed at a LAN
  # address is one the recipient can neither use nor diagnose.
  echo "  Server: $(grep -E '^EXPO_PUBLIC_API_URL=' app/.env | cut -d= -f2-)"
  echo "  Sideload: adb install -r $dest — or send the file and have them"
  echo "  allow installing from that source when Android asks."
  # Not "keep it in the foreground" any more: the foreground service landed
  # 2026-09-03 and nobody has yet watched it keep a call alive on a handset, so
  # the useful thing to ask for is the observation rather than the avoidance.
  echo "  Ask them to background a call and say whether the audio survives —"
  echo "  the foreground service is unwatched on a real handset."
}

aab() {
  require_sdk
  require_jdk17
  ensure_fresh

  # **An App Bundle, not an APK, because Play takes nothing else** for a new
  # app. Google re-packages it into per-device APKs at install time, which is
  # also why the arm64-only trick `--apk` uses is not wanted here: the bundle
  # should carry every architecture and let Play choose. So no
  # `reactNativeArchitectures` override below, and the .aab being larger than
  # the .apk is expected rather than a mistake.
  local creds="$HOME/.config/thefloor/upload-keystore.txt"
  [ -f "$creds" ] || fail "no upload key at $creds
  It is generated once and kept out of the tree — see planning/CREDENTIALS.md.
  Without it a bundle can only be debug-signed, which Play refuses."

  # shellcheck disable=SC1090
  local KEYSTORE KEY_ALIAS KEYSTORE_PASSWORD KEY_PASSWORD
  KEYSTORE=$(grep -E '^KEYSTORE=' "$creds" | cut -d= -f2-)
  KEY_ALIAS=$(grep -E '^KEY_ALIAS=' "$creds" | cut -d= -f2-)
  KEYSTORE_PASSWORD=$(grep -E '^KEYSTORE_PASSWORD=' "$creds" | cut -d= -f2-)
  KEY_PASSWORD=$(grep -E '^KEY_PASSWORD=' "$creds" | cut -d= -f2-)
  [ -f "$KEYSTORE" ] || fail "upload keystore missing at $KEYSTORE"

  say "building a signed App Bundle"
  # **Signing is injected on the command line rather than written into
  # `android/app/build.gradle`, and that is forced rather than chosen.**
  # `android/` is gitignored and regenerated by prebuild, so any signingConfig
  # edited into it is discarded the next time anybody runs `--prebuild` — and
  # discarded quietly, leaving a bundle signed with the debug key that Play
  # rejects at upload with a message about the wrong certificate. These are the
  # same properties Android Studio's "Generate Signed Bundle" uses.
  #
  # The cost is that the passwords are visible in `ps` for the life of the
  # build. That is accepted on a single-user development machine and would not
  # be on a shared one; the alternative is a config plugin that rewrites the
  # gradle file at prebuild time, which is more machinery than one upload a
  # week justifies.
  ( cd app/android && ./gradlew bundleRelease \
      -Pandroid.injected.signing.store.file="$KEYSTORE" \
      -Pandroid.injected.signing.store.password="$KEYSTORE_PASSWORD" \
      -Pandroid.injected.signing.key.alias="$KEY_ALIAS" \
      -Pandroid.injected.signing.key.password="$KEY_PASSWORD" )

  local out=app/android/app/build/outputs/bundle/release/app-release.aab
  [ -f "$out" ] || fail "gradle reported success but $out is missing"
  echo
  echo "✓ $out"
  echo "  $(du -h "$out" | cut -f1), versionCode $(grep -oE 'versionCode [0-9]+' app/android/app/build.gradle | head -1 | cut -d' ' -f2)"
  echo "  Upload at play.google.com/console → your app → Testing → Internal testing."
}

prebuild() {
  say "regenerating android/ from app.json"
  # `--clean` rather than a plain prebuild: without it the generator merges into
  # what is there, and the merge is what silently keeps a stale value. The
  # directory is gitignored and holds nothing hand-written, so there is nothing
  # to lose by discarding it — `app.json` is the source, and `app/modules/`
  # holds the only native code this project writes itself.
  ( cd app && npx expo prebuild -p android --clean )
  # Written after the generator runs, not before: `--clean` wipes the directory
  # this lives in, so a stamp written first is a stamp that is deleted and then
  # missed. Missing reads as stale, which is the safe way round.
  shasum -a 256 app/app.json | cut -d' ' -f1 > "$STAMP"
}

run() {
  require_sdk
  require_jdk17
  [ "${1:-}" = "--prebuild" ] && prebuild
  boot_emulator
  say "building and installing (first build is slow — Gradle has nothing cached)"
  npm run android --prefix app
}

# ---------------------------------------------------------------------------

case "${1:-}" in
  --setup)    setup ;;
  --prebuild) run --prebuild ;;
  --apk)      apk ;;
  --aab)      aab ;;
  "")         run ;;
  *)          fail "usage: bin/android [--setup | --prebuild | --apk | --aab]" ;;
esac
