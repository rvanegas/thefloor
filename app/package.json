    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "livekit-client": "^2.21.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
