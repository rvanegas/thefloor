#!/bin/bash
#
# Ships the server to Lightsail and restarts it.
#
#   bin/deploy            refuses unless the tree is clean
#   bin/deploy --dirty    ships the working tree as it stands, and says so
#
# Deliberately rsync rather than git: there is no remote yet, and this keeps
# deployment to one command that *can* ship a dirty tree. Excludes are the
# point — node_modules is rebuilt on the far side for that architecture, and
# .env there holds production secrets this must never overwrite.
#
# **A dirty tree needs asking for, since 2026-08-21.** This warned and
# continued until then, on the argument that refusing would take away the
# property the rsync was chosen for. The argument was right about the
# capability and wrong about the default. What it did not account for is that
# shipping the working tree makes a deploy carry whatever is in the checkout at
# the time — so unrelated work in progress rides along, and the person running
# it is usually deploying for a different reason and has no idea it is there.
# That has happened: planning/decisions/DECISIONS.md records the box sitting on `cc0e8a9`
# for a day from an accidental run, and it is worse now that several sessions
# share one checkout and one of them may be holding a half-finished schema
# migration.
#
# So the capability stays and the accident goes, on `bin/db --write`'s
# reasoning: poking at production is a normal thing to want to do, and doing it
# by accident on the way to something else is not.
#
# Live channels live in memory, so a restart drops every call in progress.
# There is no way around that yet; see planning/BACKLOG.md.
set -euo pipefail

HOST=${THEFLOOR_HOST:-ubuntu@44.241.121.49}
KEY=${THEFLOOR_KEY:-~/.ssh/lightsail-ubuntu}
SSH="ssh -i $KEY -o BatchMode=yes"

cd "$(dirname "$0")/.."

allow_dirty=false
for arg in "$@"; do
  case "$arg" in
    --dirty) allow_dirty=true ;;
    # The whole comment block, however long it grows — same as bin/db, and for
    # the same reason: a fixed line range silently truncates the help the
    # moment the header gains a line.
    -h|--help)
      awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
      exit 0
      ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

# Before the tests rather than after, so a tree that is going to be refused is
# refused in a second instead of at the end of a minute's work. The porcelain
# check is repeated below where the stamp is written; it is two lines and
# reads locally, which is cheaper than carrying state between the two.
if [ -z "$(git status --porcelain)" ]; then
  :
elif $allow_dirty; then
  : # Asked for. The warning and the -dirty stamp are below, unchanged.
else
  echo "✗ the tree is dirty; this ships the working tree, not a commit" >&2
  echo >&2
  git status --short >&2
  echo >&2
  echo "  commit or stash first, or 'bin/deploy --dirty' to ship it as it is" >&2
  exit 1
fi

# core and server, not app: this ships the server, and a phone's rendering is
# not something a deploy can break.
echo "→ tests"
npm test --prefix core --silent >/dev/null
npm test --prefix server --silent >/dev/null

# Added 2026-08-19, because the tests alone are not a compile.
#
# Jest runs TypeScript through babel, which strips types without checking them,
# and `tsx` in production does the same — so nothing in the deploy path had ever
# type-checked anything. A call to a function that had been deleted sat on
# master under a green test run until somebody ran `npm run typecheck` by hand.
# That one was in app/ and could not have reached the box, but the same hole is
# open on server/, where it would be a route throwing ReferenceError at the
# first request after a restart.
#
# Blocking on the two packages that are about to run on the box; warning on the
# app, which is not, on the same reasoning as the dirty-tree warning below —
# refusing to ship a server fix over a type error in a file this script does not
# send would be the gate deciding something that is not its business.
# Not redirected, unlike the tests above: tsc says nothing on success and
# writes its errors to stdout, so sending that to /dev/null would abort the
# deploy with no reason given.
echo "→ types"
npm run typecheck --prefix core --silent
npm run typecheck --prefix server --silent
if ! npm run typecheck --prefix app --silent; then
  echo "⚠ app does not typecheck — not shipped here, but the next build is" >&2
fi

# The guest page, bundled here rather than on the box.
#
# `livekit-client` is a browser dependency and `esbuild` is a build tool, so
# both are devDependencies — and the install below is `--omit=dev`, which is
# what keeps a 2GB instance from carrying a toolchain it runs once. Building
# locally and syncing the result keeps that true. The output is gitignored, so
# this does not dirty the tree the check above just insisted was clean.
#
# It is not conditional on anything: a stale bundle is a page whose behaviour
# is a deploy behind its server, and nothing on it would say so.
echo "→ building the guest page"
npm run build:web --prefix server --silent

# The .env pattern is a wildcard with one exception, matching .gitignore and for
# the same reason: a .env~ left by an editor or a .env.bak left by a careful
# person is exactly as secret-bearing as .env itself, and an exact-match exclude
# catches neither — it would sync one up, or delete one that only exists on the
# box. .env.example is the one that is documentation rather than a secret.
# What is about to be running, recorded before it goes rather than inferred
# afterwards. This syncs like any other file and is read by server/src/release.ts.
#
# The dirty marker is the point. This script ships the working tree on purpose,
# so "which commit is on the box" has an honest answer only when the tree was
# clean — and the times it was not are exactly the times somebody will later
# want to know. Reaching here dirty now means somebody passed --dirty, so this
# records a decision rather than catching an accident; the guard above is what
# turns the second into the first. Its value is entirely in being rare, and a
# box that is usually -dirty reports nothing at all.
SHA=$(git rev-parse --short HEAD)
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ -n "$(git status --porcelain)" ]; then
  SHA="$SHA-dirty"
  echo "⚠ deploying a dirty tree — the box will record $SHA" >&2
fi
if [ "$BRANCH" != "master" ]; then
  echo "⚠ deploying from $BRANCH, not master" >&2
fi
cat > server/deployed.json <<JSON
{
  "commit": "$SHA",
  "branch": "$BRANCH",
  "at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
JSON

echo "→ syncing"
rsync -az --delete -e "$SSH" \
  --exclude node_modules --exclude .git --exclude 'app/' \
  --include '.env.example' --exclude '.env*' \
  --exclude '*.db' --exclude '*.db-*' --exclude 'dev-*.mjs' \
  --exclude '*.p8' \
  ./ "$HOST:/home/ubuntu/thefloor/"

# Gone from here the moment it has landed there. It is a fact about one box,
# and a copy left in the checkout would have a local `npm start` reporting the
# revision of somebody's last deploy — a wrong answer being worse than the
# "unknown" that a checkout is supposed to give.
rm -f server/deployed.json

echo "→ installing and restarting"
$SSH "$HOST" '
  cd ~/thefloor/server && npm install --omit=dev --no-audit --no-fund --silent
  sudo systemctl restart thefloor
'

echo "→ waiting for health"
for _ in $(seq 1 20); do
  if curl -sf --max-time 5 https://thefloor.rvanegas.co/healthz >/dev/null; then
    HEALTH=$(curl -s https://thefloor.rvanegas.co/healthz)
    echo "✓ $HEALTH"
    # Health said yes; this says it is the code that was just sent. A restart
    # that failed and left the previous process serving looks identical
    # otherwise — which is the failure most worth catching, since everything
    # afterwards gets verified against the wrong revision.
    case "$HEALTH" in
      *"\"$SHA\""*) ;;
      *) echo "✗ healthy, but not reporting $SHA — the restart did not take" >&2
         exit 1 ;;
    esac
    exit 0
  fi
  sleep 2
done

echo "✗ did not come back healthy; check: $SSH $HOST 'journalctl -u thefloor -n 40'" >&2
exit 1
