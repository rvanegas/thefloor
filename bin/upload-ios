#!/bin/bash
#
# Archives the iOS app and uploads it to App Store Connect for TestFlight.
#
# This is step one of four, and the name says which. **Upload** puts a build in
# TestFlight; **submit** puts an uploaded build in front of App Review; Apple
# **approves**; **release** makes an approved build downloadable. This script
# was `bin/release-ios` until 2026-08-21, which named it for the step it does
# not do — the `released` tag marks step four, so one word sat at both ends of
# the pipeline. RELEASING.md defines the four; DECISIONS.md argues the split.
#
# Signing is automatic and cloud-managed: the distribution certificate and
# provisioning profile are created by Apple on first use and never appear in
# the local keychain, so `security find-identity` showing only a development
# certificate is expected and not a problem.
#
# DEVELOPMENT_TEAM has to be passed explicitly because `prebuild --clean`
# regenerates ios/ and drops it, leaving an archive that fails with "requires a
# development team".
set -euo pipefail

TEAM=${APPLE_TEAM_ID:-9946JKHZUJ}
WORKSPACE=app/ios/TheFloor.xcworkspace
SCHEME=TheFloor
ARCHIVE=/tmp/thefloor.xcarchive

cd "$(dirname "$0")/.."

# An App Store Connect API key, if there is one, so that neither signing nor
# uploading depends on an Apple ID being signed in to Xcode.
#
# That dependency is what this exists to remove. Build 21 archived fine and then
# failed at the upload with "Failed to Use Accounts" — Xcode's account list had
# simply emptied overnight, with nobody having signed out. A key belongs to the
# team rather than to a person, is not a session, and does not expire.
#
# The key id is read from the filename, exactly as the APNs key's is, so there
# is one fewer thing to record. The issuer id is a plain file beside it: it is
# not a secret, but it is unmemorable and it belongs with the key it names.
# Both live outside the tree, because `bin/deploy` rsyncs with --delete.
#
# Its own directory, and that is not tidiness. The APNs key is a `.p8` under
# `~/.config/thefloor` too, and an `AuthKey_*.p8` glob there matched *it* first
# — alphabetically, silently, and with no way to tell the two apart by content,
# since both are ES256 private keys. This would have signed the release with the
# push key and failed at Apple with something unrecognisable.
ASC_DIR=${THEFLOOR_ASC_DIR:-$HOME/.config/thefloor/asc}
ASC_KEY=$(ls "$ASC_DIR"/AuthKey_*.p8 2>/dev/null | head -1 || true)
ASC_ISSUER=${APP_STORE_CONNECT_ISSUER_ID:-}
if [ -z "$ASC_ISSUER" ] && [ -f "$ASC_DIR/issuer-id" ]; then
  ASC_ISSUER=$(tr -d '[:space:]' < "$ASC_DIR/issuer-id")
fi
if [ "$(ls "$ASC_DIR"/AuthKey_*.p8 2>/dev/null | wc -l)" -gt 1 ]; then
  echo "✗ more than one key in $ASC_DIR; cannot tell which is the release key" >&2
  exit 1
fi

AUTH=()
if [ -n "$ASC_KEY" ] && [ -n "$ASC_ISSUER" ]; then
  ASC_KEY_ID=$(basename "$ASC_KEY" .p8)
  ASC_KEY_ID=${ASC_KEY_ID#AuthKey_}
  AUTH=(
    -authenticationKeyPath "$ASC_KEY"
    -authenticationKeyID "$ASC_KEY_ID"
    -authenticationKeyIssuerID "$ASC_ISSUER"
  )
  echo "→ authenticating as API key $ASC_KEY_ID"
else
  # Not fatal: the interactive path still works when somebody is signed in, and
  # refusing to release for want of a key would be worse than saying so.
  echo "→ no API key found in $ASC_DIR; falling back to Xcode's signed-in account" >&2
  echo "  (a missing account fails at the upload with 'Failed to Use Accounts')" >&2
fi

# A tag is a permanent claim that a build was made from a particular commit,
# and it is worth nothing if the tree held changes that commit does not carry.
# Deliberately stricter than bin/deploy, which ships a dirty tree on purpose:
# a deploy is reversible in a minute and a build in the App Store is not.
if [ -n "$(git status --porcelain)" ]; then
  echo "✗ working tree is not clean; commit or stash before releasing" >&2
  git status --short >&2
  exit 1
fi

# Every upload needs a build number Apple has not seen before, even when the
# version is unchanged. Bumping it here means one fewer thing to forget.
BUILD=$(node - <<'JS'
const fs = require('fs');
const path = 'app/app.json';
const cfg = JSON.parse(fs.readFileSync(path, 'utf8'));
const next = String(Number(cfg.expo.ios.buildNumber || '0') + 1);
cfg.expo.ios.buildNumber = next;
fs.writeFileSync(path, JSON.stringify(cfg, null, 2) + '\n');
console.log(next);
JS
)
echo "→ build $BUILD"

# Committed before the archive, not after, so the commit is what gets built
# rather than a description of it. ios/ is generated and gitignored, so
# prebuild leaves the tree clean and this stays the only change.
git add app/app.json
git commit -q -m "Bump iOS build number to $BUILD"

# --clean, deliberately. Without it, prebuild reuses the existing ios/ and a
# newly added native dependency can fail to be linked at all — which is how
# build 2 shipped without expo-document-picker, throwing at module scope and
# rendering the app as a black screen for every tester. Regenerating costs a
# couple of minutes; shipping an app that cannot start costs a build.
#
# DEVELOPMENT_TEAM is dropped by --clean and passed back explicitly below.
echo "→ prebuild"
(cd app && npx expo prebuild --platform ios --clean >/dev/null)

# Prebuild is not trusted to have done it: the failure being guarded against is
# silent, and a missing pod is only visible once testers see a black screen.
#
# The expected pods come from the autolinker rather than from guessing at
# package names — expo-status-bar is JS-only and has no pod at all, so a naive
# name-to-pod mapping fails every release for a module that was never meant to
# be there.
echo "→ checking native modules are linked"
(cd app && npx expo-modules-autolinking resolve --platform ios --json) \
  > /tmp/thefloor-autolink.json 2>/dev/null
node - <<'JS'
const fs = require('fs');
const lock = fs.readFileSync('app/ios/Podfile.lock', 'utf8');
const { modules } = JSON.parse(
  fs.readFileSync('/tmp/thefloor-autolink.json', 'utf8')
);
const expected = modules.flatMap((m) =>
  (m.pods ?? []).map((p) => ({ pod: p.podName, pkg: m.packageName }))
);
const missing = expected.filter(({ pod }) => !lock.includes(pod));
if (missing.length) {
  console.error('✗ autolinked but absent from Podfile.lock:');
  for (const { pod, pkg } of missing) console.error(`    ${pkg} → ${pod}`);
  console.error('  The archive would build and fail at launch. Stopping.');
  process.exit(1);
}

// The check above can only see a module the autolinker already knows about, so
// it is blind to one that was never linked at all — which is a *quieter*
// failure and cost build 61 on 2026-08-20. A local module keeps its native
// source in a directory called `ios`, `.gitignore` carried an unanchored `ios/`
// rule, and `git add -A` committed the module's config and TypeScript while
// silently dropping the Swift and the podspec. Without a podspec the module is
// not autolinked, so nothing was missing from the lock, this check passed, the
// archive built, and the diagnostic the module existed for reported "route
// unreadable" on the phone.
//
// So: every directory under app/modules is a module somebody wrote by hand and
// meant to ship. Each one must have come out of the autolinker.
const localDir = 'app/modules';
if (fs.existsSync(localDir)) {
  const linked = new Set(modules.map((m) => m.packageName));
  const unlinked = fs
    .readdirSync(localDir, { withFileTypes: true })
    .filter((e) => e.isDirectory())
    .map((e) => e.name)
    .filter((name) => !linked.has(name));
  if (unlinked.length) {
    console.error('✗ local modules present on disk but not autolinked:');
    for (const name of unlinked) console.error(`    ${localDir}/${name}`);
    console.error('  Usually a missing podspec — check `git status --ignored`');
    console.error('  before assuming the file is there. Stopping.');
    process.exit(1);
  }
}

console.log(`  ${expected.length} native modules present in Podfile.lock`);
JS

echo "→ archive"
rm -rf "$ARCHIVE"
# The key is passed to the archive too, not only the upload: automatic signing
# fetches profiles from the portal, and doing that through the key is what keeps
# the whole release working with nobody signed in.
xcodebuild -workspace "$WORKSPACE" -scheme "$SCHEME" \
  -configuration Release -destination 'generic/platform=iOS' \
  -archivePath "$ARCHIVE" -allowProvisioningUpdates \
  ${AUTH[@]+"${AUTH[@]}"} \
  DEVELOPMENT_TEAM="$TEAM" CODE_SIGN_STYLE=Automatic \
  archive >/tmp/thefloor-archive.log 2>&1 \
  || { echo "✗ archive failed; see /tmp/thefloor-archive.log" >&2; exit 1; }

echo "→ upload"
cat > /tmp/UploadOptions.plist <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>method</key><string>app-store-connect</string>
  <key>teamID</key><string>$TEAM</string>
  <key>signingStyle</key><string>automatic</string>
  <key>destination</key><string>upload</string>
  <key>uploadSymbols</key><true/>
  <!--
    Without this, Xcode renumbers the build on the way out. It defaults to YES,
    it applies at the export that re-signs for distribution, and it is silent:
    build 43 was archived carrying CFBundleVersion 43 and arrived in TestFlight
    as 44. Everything downstream then names a binary that does not exist — the
    bump commit, the build/<n> tag, and app.json, which is left a number behind
    what Apple holds and so bumps straight into a taken number on the next
    release.

    Apple's reason for the default is to spare you a refused upload when the
    number is already used. That is worth less here than the numbers agreeing,
    since bin/upload-ios owns the number and increments it itself.
  -->
  <key>manageAppVersionAndBuildNumber</key><false/>
</dict></plist>
PLIST

xcodebuild -exportArchive -archivePath "$ARCHIVE" \
  -exportPath /tmp/thefloor-upload \
  -exportOptionsPlist /tmp/UploadOptions.plist \
  ${AUTH[@]+"${AUTH[@]}"} \
  -allowProvisioningUpdates 2>&1 | grep -E "Uploaded|EXPORT (SUCCEEDED|FAILED)|error:"

# Tagged here rather than beside the commit, because the tag means "Apple has
# this" and nothing before the upload can promise that. An archive that failed
# leaves the bump commit behind and no tag, which is the honest record: the
# build number is spent either way — Apple will not take it twice — but no
# revision claims to be a build that does not exist.
git tag -a "build/$BUILD" -m "iOS build $BUILD, uploaded to App Store Connect"
echo "→ tagged build/$BUILD (git push origin build/$BUILD)"

echo "✓ processing in App Store Connect — TestFlight in a few minutes"
