#!/bin/bash
#
# Copies server/.env off the box into ~/.config/thefloor/server.env.
#
# The box holds the only live copy of seven credentials, and bin/deploy
# deliberately refuses to touch it — so nothing has ever brought it back. What
# stood in for a backup was ~/.config/thefloor/backup-2026-08-13/server.env, a
# snapshot taken during a migration that was six days stale within a week.
#
# The local copy goes beside the .p8 keys and livekit.env, under
# ~/.config/thefloor, mode 600, on the same reasoning: outside any tree
# bin/deploy rsyncs with --delete, and outside git.
#
# Values are never printed. What changed is reported by key name alone, which
# is enough to see that something moved and useless to anybody reading over a
# shoulder or scrolling back through a terminal.
set -euo pipefail

HOST=${THEFLOOR_HOST:-ubuntu@44.241.121.49}
KEY=${THEFLOOR_KEY:-~/.ssh/lightsail-ubuntu}
SSH="ssh -i $KEY -o BatchMode=yes"
LOCAL=${THEFLOOR_ENV:-$HOME/.config/thefloor/server.env}
REMOTE=/home/ubuntu/thefloor/server/.env

TMP=$(mktemp); chmod 600 "$TMP"; trap 'rm -f "$TMP"' EXIT

echo "→ fetching $REMOTE"
$SSH "$HOST" "cat $REMOTE" > "$TMP"

# An empty answer is what a missing file, a wrong path or a silently failed ssh
# all look like, and writing it over the local copy would destroy the thing
# this script exists to protect.
if [ ! -s "$TMP" ]; then
  echo "✗ came back empty — not overwriting $LOCAL" >&2
  exit 1
fi

names() { { grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' "$1" | tr -d '=' | sort; } || true; }

# Which keys differ between two env files, by name. A key whose value changed
# and a key that was added read the same way here, which is the intended amount
# of detail — values are never printed.
#
# The `|| true` is load-bearing and cost an afternoon. `diff` exits 1 when the
# files differ, `grep` exits 1 when it matches nothing, and under
# `set -o pipefail` either sinks the whole pipeline — so an unguarded
# assignment aborts the script under `set -e` exactly when there IS a
# difference, which is the only case anybody runs this for. It printed nothing
# and exited 1, which is indistinguishable from having found nothing to do.
changed_keys() {
  { diff <(sort "$1") <(sort "$2") \
    | grep -oE '^[<>] [A-Za-z_][A-Za-z0-9_]*=' \
    | grep -oE '[A-Za-z_][A-Za-z0-9_]*' \
    | sort -u | tr '\n' ' '; } || true
}

if [ -f "$LOCAL" ]; then
  if cmp -s "$TMP" "$LOCAL"; then
    echo "✓ already identical — $(names "$LOCAL" | wc -l | tr -d ' ') keys"
    exit 0
  fi
  CHANGED=$(changed_keys "$LOCAL" "$TMP")
  echo "  differs in: ${CHANGED:-(comments or blank lines only)}"
  # Pulling over local edits is how work gets lost quietly — the local file is
  # the one somebody has just been typing in, and the box's copy is older by
  # definition whenever a push is what was meant. The .bak makes it recoverable;
  # -f makes it deliberate.
  if [ "${1:-}" != "-f" ]; then
    echo "✗ $LOCAL differs from the box and would be overwritten." >&2
    echo "  bin/env-push to send yours, or bin/env-pull -f to take the box's." >&2
    exit 1
  fi
  cp "$LOCAL" "$LOCAL.bak"
  echo "  previous copy kept at $LOCAL.bak"
fi

mkdir -p "$(dirname "$LOCAL")"
cp "$TMP" "$LOCAL"
chmod 600 "$LOCAL"
echo "✓ $LOCAL — $(names "$LOCAL" | wc -l | tr -d ' ') keys, mode 600"
