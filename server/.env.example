# Copy to server/.env and fill in. That file is gitignored — never commit it.

# --- Audio (LiveKit Cloud) -------------------------------------------------
# Settings -> General for the URL, Settings -> API keys for the pair.
# The secret belongs ONLY here. It must never reach the app: clients receive a
# short-lived join token minted by this server. A secret in the binary would let
# anyone mint tokens for any room and join any session.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Recordings (S3 via LiveKit Egress) --------------------------------------
# These credentials are sent to LiveKit with each egress request, so they leave
# your account. Scope the IAM user to s3:PutObject on this bucket alone.
RECORDINGS_BUCKET=thefloor-recordings
RECORDINGS_REGION=us-west-2
RECORDINGS_AWS_ACCESS_KEY_ID=
RECORDINGS_AWS_SECRET_ACCESS_KEY=

# --- Email (AWS SES) -------------------------------------------------------
# Unset MAIL_FROM to print one-time codes to this console instead of sending
# them, which is faster for local work.
MAIL_FROM=noreply@rvanegas.co
AWS_REGION=us-west-2
AWS_PROFILE=amplify

# --- Server ----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
DB_PATH=./thefloor.db
