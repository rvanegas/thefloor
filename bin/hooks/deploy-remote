#!/bin/bash
# After `ts deploy` syncs: install and restart on the box. Live channels live
# in memory, so this restart drops every call in progress.
set -euo pipefail
ssh -o BatchMode=yes "$HOST" '
  cd ~/thefloor/server && npm install --omit=dev --no-audit --no-fund --silent
  sudo systemctl daemon-reload
  sudo systemctl restart thefloor
'
