# Copy to server/.env and fill in. That file is gitignored — never commit it.

# --- Audio (LiveKit) --------------------------------------------------------
# Production self-hosts this on the same box since 2026-08-13 — see
# planning/DECISIONS.md — so the pair is self-issued with
# `livekit-server generate-keys` and must match /etc/livekit/livekit.yaml and
# /etc/livekit/egress.yaml. For LiveKit Cloud instead, take the URL from
# Settings -> General and the pair from Settings -> API keys.
# The secret belongs ONLY here. It must never reach the app: clients receive a
# short-lived join token minted by this server, and are told the URL by it too.
# A secret in the binary would let anyone mint tokens for any room and join any
# session.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Recordings (S3 via LiveKit Egress) --------------------------------------
# Sent to the egress service with each request. Self-hosted they stay on the
# box; against LiveKit Cloud they leave your account. Either way, scope the IAM
# user to s3:PutObject on this bucket alone — a key that can only add is a
# smaller blast radius than one that can read every conversation back.
RECORDINGS_BUCKET=thefloor-recordings
RECORDINGS_REGION=us-west-2
RECORDINGS_AWS_ACCESS_KEY_ID=
RECORDINGS_AWS_SECRET_ACCESS_KEY=

# --- Email (AWS SES) -------------------------------------------------------
# Unset MAIL_FROM to print one-time codes to this console instead of sending
# them, which is faster for local work.
MAIL_FROM=noreply@rvanegas.co
AWS_REGION=us-west-2
AWS_PROFILE=amplify

# --- Notifications (Apple Push Notification service) ------------------------
# The .p8 auth key from the developer portal, downloadable exactly once. Keep it
# outside this tree — bin/deploy rsyncs with --delete, and a key inside the
# synced directory is a key a later deploy can remove. ~/.config/thefloor/ on
# the box and on a development machine alike.
# APNS_ENV is the setting most likely to be wrong: a device token from a debug
# build works only against sandbox, one from TestFlight only against production,
# and the wrong pairing fails with a bare BadDeviceToken that blames the token.
# Leave APNS_KEY_PATH unset to print notifications to this console instead.
APNS_KEY_PATH=/home/ubuntu/.config/thefloor/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=9946JKHZUJ
APNS_BUNDLE_ID=co.rvanegas.thefloor
APNS_ENV=production

# --- Donations (Ko-fi) ------------------------------------------------------
# Voluntary, and they unlock nothing — an account that has never given behaves
# exactly like one that has.
#
# KOFI_URL is what the app opens in the browser. It is deliberately not in the
# binary: leaving it unset withdraws the donate link from every installed build
# at the next restart, which is the remedy if the App Store guideline that
# permits an external payment link (3.1.1(a), United States storefront only) is
# reversed on appeal.
#
# KOFI_VERIFICATION_TOKEN is from More -> API -> Webhooks -> Advanced on Ko-fi,
# and the webhook URL to give them is https://<this host>/donations/kofi. The
# token is a shared secret sent inside the request body rather than a signature,
# so it is only safe because Caddy terminates TLS in front of this. Unset, every
# delivery is refused rather than trusted.
#
# Note that Ko-fi has no read API: a delivery missed while this server was down
# cannot be fetched later, only copied out of their dashboard by hand. Their
# dashboard is the authoritative record; this database is a convenience copy.
KOFI_URL=https://ko-fi.com/yourpage
KOFI_VERIFICATION_TOKEN=

# --- App Review -------------------------------------------------------------
# One address whose one-time code is fixed rather than random, because signing
# in here means reading a code out of an inbox and App Review has no inbox. Both
# are required; either alone configures nothing. Publish the pair in the review
# notes and treat it as public — point it at an account holding demo data and
# nothing else. Leave both unset outside a submission.
REVIEW_IDENTIFIER=
REVIEW_CODE=

# --- Privacy policy ---------------------------------------------------------
# Served at /privacy, which App Store Connect requires a URL for before it will
# accept a submission. This address appears on that page as the way to ask
# questions and to request account deletion, which the policy promises. Unset,
# the page points at the support address on the App Store listing instead.
CONTACT_EMAIL=

# --- Server ----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
DB_PATH=./thefloor.db
