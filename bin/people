#!/bin/bash
#
# Everybody with an account here, least recently seen first.
#
#   bin/people                 against the deployed server
#   bin/people --local         the development database on this machine
#
# Read-only, always. This is the roster, not an admin tool: bin/db --write is
# where editing lives, and it makes you ask for it.
#
# The order is deliberate and is the opposite of the interesting one. Sorted
# ascending, the rows that need attention come first — accounts that have never
# connected sort above everything, since last_seen_at is null until a first
# heartbeat — and the people who were here five minutes ago are at the bottom,
# next to the prompt.
#
# `last_seen` is `last_seen_at` rendered as a UTC datetime rather than the
# epoch milliseconds it is stored as, and `days_ago` is the same number said
# the way you were going to work it out anyway. Both are empty for somebody who
# has never connected, rather than 1970.
#
# Two kinds of row are not people:
#
#   * `erased:acct_…` is a tombstone. Erasure rewrites the identifier rather
#     than deleting the row, because channels and contacts still reference it;
#     see accounts.ts § ERASED_IDENTIFIER_PREFIX.
#   * The two App Review accounts, `appreview@` and `appreview2@`, are Apple's
#     and are torn down in an order that matters. See planning/DEMO-ACCOUNT.md.
#
# `build` is what they last connected from, and null means "at or below the
# first build that says" — every build up to 36 sends nothing, so a blank is
# not the same as an old number and cannot be compared with one. `expired` is
# that comparison where it can be made: 1 means this install is below the
# server's compatibility floor and has already replaced itself with an update
# screen. The floor is read from the server being queried — /healthz's
# `minBuild` — rather than from this checkout, which can be ahead of what is
# deployed. If it cannot be read, the column is blank rather than guessed.
set -euo pipefail

HOST=${THEFLOOR_HOST:-ubuntu@44.241.121.49}
KEY=${THEFLOOR_KEY:-~/.ssh/lightsail-ubuntu}
REMOTE_DB=/home/ubuntu/thefloor-data/thefloor.db
HEALTH_URL=${THEFLOOR_URL:-https://thefloor.rvanegas.co}/healthz
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LOCAL_DB="$ROOT/server/thefloor.db"

local_mode=false

for arg in "$@"; do
  case "$arg" in
    --local) local_mode=true ;;
    # The whole comment block, however long it grows — the same reasoning as
    # bin/db, where a fixed line range truncated the help the moment the header
    # gained a line.
    -h|--help)
      awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
      exit 0
      ;;
    *) echo "Unknown option: $arg" >&2; exit 1 ;;
  esac
done

# Where the floor comes from differs by mode, and neither source is the other's
# substitute: the deployed server is the authority on what it enforces, and a
# local database is being read by a local checkout. Anything that is not a bare
# number is discarded — this value is interpolated into SQL below, so that test
# is what keeps it safe, rather than the source being trusted.
floor=""
if $local_mode; then
  floor=$(sed -n 's/^export const MIN_SUPPORTED_BUILD = \([0-9]*\).*/\1/p' \
    "$ROOT/server/src/release.ts" || true)
else
  floor=$(curl -fsS --max-time 5 "$HEALTH_URL" 2>/dev/null \
    | sed -n 's/.*"minBuild":[[:space:]]*\([0-9]*\).*/\1/p' || true)
fi
[[ "$floor" =~ ^[0-9]+$ ]] || floor=""

if [ -n "$floor" ]; then
  # Blank rather than 0 where there is no build to compare, which is the point
  # the header makes and which `last_build < $floor` would quietly lose: NULL
  # is not below the floor and is not at or above it either.
  expired="CASE WHEN last_build IS NULL THEN ''
                WHEN last_build < $floor THEN 1 ELSE 0 END"
else
  expired="''"
fi

sql="
SELECT identifier,
       display_name,
       last_build AS build,
       $expired AS expired,
       CASE WHEN last_seen_at IS NULL THEN ''
            ELSE datetime(last_seen_at / 1000, 'unixepoch') END AS last_seen,
       CASE WHEN last_seen_at IS NULL THEN ''
            ELSE ROUND((unixepoch() * 1000 - last_seen_at) / 86400000.0, 1)
       END AS days_ago,
       date(created_at / 1000, 'unixepoch') AS joined
FROM accounts
ORDER BY last_seen_at;

.print ''
SELECT COUNT(*) AS accounts,
       SUM(identifier LIKE 'erased:%') AS erased,
       SUM(last_seen_at > unixepoch() * 1000 - 604800000) AS seen_this_week
FROM accounts;
"

# Column headers and aligned output: this is for reading, not for piping into
# something else.
opts=(-readonly -header -column -cmd '.timeout 2000')

if $local_mode; then
  [ -f "$LOCAL_DB" ] || { echo "No local database at $LOCAL_DB" >&2; exit 1; }
  echo "→ local${floor:+ · floor build $floor}"
  exec sqlite3 "${opts[@]}" "$LOCAL_DB" <<<"$sql"
fi

echo "→ production${floor:+ · floor build $floor}"
# Over stdin rather than interpolated into the remote shell, for the reason
# bin/db spells out: $, backticks and backslashes are all live in that position.
exec ssh -i "$KEY" -o BatchMode=yes "$HOST" \
  "sqlite3 -readonly -header -column -cmd '.timeout 2000' '$REMOTE_DB'" \
  <<<"$sql"
