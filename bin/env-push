#!/bin/bash
#
# Copies ~/.config/thefloor/server.env onto the box and restarts the server.
#
# The pattern is bin/provision-livekit's, which has always read livekit.env from
# ~/.config/thefloor rather than having somebody type secrets into a box: the
# credential is authored locally, in a file that can be backed up and diffed,
# and the box is a deployment target rather than the place state lives. This
# extends that to the seven credentials in server/.env, which until now existed
# in exactly one place.
#
# Editing on the box directly is still fine. Run bin/env-pull afterwards and the
# local copy catches up; this script is what makes the reverse direction work.
#
# Values are never printed — see bin/env-pull.
set -euo pipefail

HOST=${THEFLOOR_HOST:-ubuntu@44.241.121.49}
KEY=${THEFLOOR_KEY:-~/.ssh/lightsail-ubuntu}
SSH="ssh -i $KEY -o BatchMode=yes"
LOCAL=${THEFLOOR_ENV:-$HOME/.config/thefloor/server.env}
REMOTE=/home/ubuntu/thefloor/server/.env

cd "$(dirname "$0")/.."

ASSUME_YES=no
[ "${1:-}" = "-y" ] && ASSUME_YES=yes

[ -f "$LOCAL" ] || { echo "✗ no $LOCAL — run bin/env-pull first" >&2; exit 1; }

names() { { grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' "$1" | tr -d '=' | sort; } || true; }

# Which keys differ between two env files, by name. A key whose value changed
# and a key that was added read the same way here, which is the intended amount
# of detail — values are never printed.
#
# The `|| true` is load-bearing and cost an afternoon. `diff` exits 1 when the
# files differ, `grep` exits 1 when it matches nothing, and under
# `set -o pipefail` either sinks the whole pipeline — so an unguarded
# assignment aborts the script under `set -e` exactly when there IS a
# difference, which is the only case anybody runs this for. It printed nothing
# and exited 1, which is indistinguishable from having found nothing to do.
changed_keys() {
  { diff <(sort "$1") <(sort "$2") \
    | grep -oE '^[<>] [A-Za-z_][A-Za-z0-9_]*=' \
    | grep -oE '[A-Za-z_][A-Za-z0-9_]*' \
    | sort -u | tr '\n' ' '; } || true
}

# Every name .env.example documents and this file does not have at all. Not a
# blank value: several are meant to be blank outside a submission, and blank is
# a decision where absent is usually an accident. MAIL_FROM went missing exactly
# this way, and unset means codes print to a console nobody is reading.
#
# A `# env-push: optional` line in .env.example exempts the next key, for the
# ones that are alternatives rather than requirements — AWS_PROFILE is the
# laptop's way of doing what AWS_ACCESS_KEY_ID does on the box, and warning
# about it every time is how a warning stops being read.
required() {
  awk '
    /^# *env-push: optional/ { skip = 1; next }
    /^[A-Za-z_][A-Za-z0-9_]*=/ {
      if (skip) { skip = 0; next }
      sub(/=.*/, ""); print; next
    }
  ' "$1" | sort
}

MISSING=$(comm -23 <(required server/.env.example) <(names "$LOCAL") | tr '\n' ' ')
if [ -n "$MISSING" ]; then
  echo "⚠ documented in .env.example and absent here: $MISSING" >&2
fi

# Say what is being compared, always. The first version of this script printed
# nothing at all when the two agreed, so a push that did not happen and a push
# that was not needed looked identical — and the one time that mattered, the
# box was missing a key the local file had. Silence is not evidence.
echo "  local:  $LOCAL ($(names "$LOCAL" | wc -l | tr -d ' ') keys, $(date -r "$LOCAL" '+%H:%M'))"

TMP=$(mktemp); chmod 600 "$TMP"; trap 'rm -f "$TMP"' EXIT
if $SSH "$HOST" "cat $REMOTE" > "$TMP" 2>/dev/null && [ -s "$TMP" ]; then
  echo "  box:    $REMOTE ($(names "$TMP" | wc -l | tr -d ' ') keys)"
  if cmp -s "$TMP" "$LOCAL"; then
    echo "✓ byte-identical — nothing to do"
    exit 0
  fi
  CHANGED=$(changed_keys "$TMP" "$LOCAL")
  echo "  will change on the box: ${CHANGED:-(comments or blank lines only)}"
else
  echo "  the box has no readable $REMOTE — this will create it"
fi

# A restart drops every call in progress, and this one replaces credentials
# rather than code, so a wrong file is a server that starts and quietly cannot
# send mail. bin/deploy does not ask; it also runs the tests first and can check
# afterwards that the right thing landed. This can do neither.
if [ "$ASSUME_YES" != yes ]; then
  printf '  push and restart? [y/N] '
  # `read` fails at end of input, and under `set -e` that would abort here with
  # the prompt half-written and no explanation — which reads exactly like the
  # script having done nothing. Answer for it instead, and say so.
  if ! read -r reply; then
    echo
    echo "  no answer available (stdin is not a terminal) — nothing sent." >&2
    echo "  run it from a terminal, or pass -y to skip the question." >&2
    exit 1
  fi
  case "$reply" in [yY]*) ;; *) echo "  nothing sent"; exit 1 ;; esac
fi

# When the running process started, so the restart can be proved rather than
# assumed. bin/deploy settles the same question by checking the box reports the
# sha it just sent; nothing changes here but the environment, so there is no sha
# to compare and the process's own start time is what is left. A restart that
# silently failed leaves the old process serving — with the old environment,
# which is exactly the thing being changed.
STARTED_BEFORE=$($SSH "$HOST" \
  "systemctl show thefloor -p ExecMainStartTimestamp --value" 2>/dev/null || true)

echo "→ sending"
# Through a temp path owned by ubuntu, then moved: scp straight onto the live
# file leaves a window where it is half-written and the server is one restart
# away from reading it.
scp -i "$KEY" -q "$LOCAL" "$HOST:/tmp/.thefloor-env"
$SSH "$HOST" "
  chmod 600 /tmp/.thefloor-env
  mv /tmp/.thefloor-env $REMOTE
  sudo systemctl restart thefloor
"

echo "→ waiting for health"
for _ in $(seq 1 20); do
  if curl -sf --max-time 5 https://thefloor.rvanegas.co/healthz >/dev/null; then
    echo "✓ $(curl -s https://thefloor.rvanegas.co/healthz)"

    STARTED_AFTER=$($SSH "$HOST" \
      "systemctl show thefloor -p ExecMainStartTimestamp --value" 2>/dev/null || true)
    if [ -n "$STARTED_BEFORE" ] && [ "$STARTED_BEFORE" = "$STARTED_AFTER" ]; then
      echo "✗ healthy, but the process did not restart — it is still the one that" >&2
      echo "  started $STARTED_AFTER, serving the previous environment." >&2
      exit 1
    fi
    echo "  restarted: $STARTED_AFTER"

    # systemd runs the unit definition it has cached. If the file on disk has
    # been edited since, the restart above used the old one and said so only in
    # a warning that scrolls past — so it is worth ending on.
    if [ "$($SSH "$HOST" "systemctl show thefloor -p NeedDaemonReload --value" 2>/dev/null || true)" = yes ]; then
      echo "⚠ thefloor.service on disk differs from what systemd is running." >&2
      echo "  sudo systemctl daemon-reload && sudo systemctl restart thefloor" >&2
    fi

    # What the startup log says it configured, which is the only report of
    # whether a setting took. Not the values — the server does not log those.
    $SSH "$HOST" "journalctl -u thefloor -n 40 --no-pager | grep -i 'unset\|review' || true"
    exit 0
  fi
  sleep 2
done

echo "✗ did not come back healthy; check: $SSH $HOST 'journalctl -u thefloor -n 40'" >&2
exit 1
