#!/bin/bash
#
# Prints every account's address and username, for noesis's register.
#
#   ts export-names            the deployed server's, to stdout
#   ts export-names --local    the development database instead
#
# One `email<TAB>username` per line, the username blank where an account has
# none — the input noesis's `scripts/reserve_names.py` reads, which is how the
# names given out here before noesis decided them (names.ts) become noesis's:
# kept where it agrees, reserved where they are free, and otherwise renamed
# here by ts rename-users, noesis winning. The order is in
# planning/decision/2026-11-02-noesis-decides-every-username.md:
#
#   ts export-names > floor-names.tsv
#   on noesis's box, reserve_names.py < floor-names.tsv, then --apply --renames
#   ts rename-users floor-renames.tsv, then --write
#
# Read-only. Addresses only, since noesis keeps a name per address; tombstones
# (`erased:…`) have nobody behind them.
#
# The file holds every user's address: write it somewhere private and delete
# it once noesis has read it.
set -euo pipefail

HOST=${THEFLOOR_HOST:-ubuntu@44.241.121.49}
KEY=${THEFLOOR_KEY:-~/.ssh/lightsail-ubuntu}
REMOTE_DB=/home/ubuntu/thefloor-data/thefloor.db
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LOCAL_DB="$ROOT/server/thefloor.db"

local_mode=false

for arg in "$@"; do
  case "$arg" in
    --local) local_mode=true ;;
    -h|--help)
      awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
      exit 0
      ;;
    *) echo "Unknown option: $arg" >&2; exit 1 ;;
  esac
done

query="
SELECT lower(trim(identifier)) || char(9) || COALESCE(username, '')
FROM accounts
WHERE identifier LIKE '%@%' AND identifier NOT LIKE 'erased:%'
ORDER BY created_at, id;"

# Over stdin rather than interpolated into the remote shell, for ts db's reason.
if $local_mode; then
  [ -f "$LOCAL_DB" ] || { echo "No local database at $LOCAL_DB" >&2; exit 1; }
  sqlite3 -readonly -noheader -cmd '.timeout 2000' "$LOCAL_DB" <<<"$query"
else
  ssh -i "$KEY" -o BatchMode=yes "$HOST" \
    "sqlite3 -readonly -noheader -cmd '.timeout 2000' '$REMOTE_DB'" <<<"$query"
fi
