# The deployed server. A TestFlight build must point here — a LAN address is
# useless to anyone who is not on this network.
EXPO_PUBLIC_API_URL=https://thefloor.rvanegas.co

# For local work against a server on this machine, comment the line above and
# use your LAN IP instead — not localhost, since a phone is not this machine:
# EXPO_PUBLIC_API_URL=http://192.168.7.150:8787
