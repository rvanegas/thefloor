#!/usr/bin/env node
//
// Prepares an uploaded build for App Review, and stops before the button.
//
//   bin/submit-ios                    prepare app.json's version and build
//   bin/submit-ios --build 64         a build other than app.json's
//   bin/submit-ios --dry-run          say what it would do and write nothing
//   bin/submit-ios --status           report what App Store Connect holds, stop
//   bin/submit-ios --sync-released    the same, and offer to move `released`
//
// This is step two of four. **upload** puts a build in TestFlight, **submit**
// puts an uploaded build in front of App Review, Apple **approves**, and
// **release** makes an approved build downloadable. RELEASING.md § *The five
// verbs* has what each costs; bin/upload-ios is the step before this one.
//
// **It does not submit.** Everything a submission needs is assembled — the
// version record, the build attached to it, "What's New", the review details,
// a reviewSubmission holding an item for the version — and then it prints the
// page to press Submit on. That seam is deliberate and is where the two kinds
// of mistake separate: everything this script does is editable or deletable in
// App Store Connect, and the last PATCH is not. A submission is a claim to
// Apple about a binary, and a human should make it having read what is on the
// screen.
//
// What it is really for is the four checks below, each of which is invisible in
// the UI until it has already cost a submission:
//
//   - **The build's version train has to match the version record**, or the
//     build picker is silently empty with nothing on screen saying why. That is
//     `expo.version` in app.json versus the `preReleaseVersion` Apple filed the
//     upload under, and they diverge whenever a version bump is forgotten.
//   - **The build has to have finished processing.** `VALID`, not `PROCESSING`.
//   - **"What's New" is required for an update** and absent by default. A first
//     submission does not need it, which is exactly why the second one forgets.
//     It is read from `planning/submissions/whats-new-<version>.txt`, named
//     after `expo.version` rather than passed in — the two texts a submission
//     sends are found the same way, and a version bump moves both.
//   - **The reviewer still has to sign in.** Every update is reviewed, so the
//     demo credentials in the review details have to be the live ones — they
//     are checked against ~/.config/thefloor/demo-account.txt, which is the
//     copy DEMO-ACCOUNT.md says is authoritative.
//
// Two things it deliberately does not touch. **App Privacy has no API at all**
// — `appPrivacyDetails`, `appDataUsages` and `dataUsages` all 404 — so it is
// checked by opening the page, and RELEASING.md § *To verify before pressing
// submit* is the list this cannot enforce. And **phased release** is a choice
// per submission rather than a setting to be defaulted, so it is left to the
// page too.
//
// Both reporting flags compare the build Apple says is downloadable against
// what the local `released` ref points at, and say when the two disagree.
// Nothing else knows about that drift — `released` is git's record of a state
// Apple holds — and `bin/deploy-web --stable` is cut from it, so a stale ref
// re-ships the previous release and says nothing is wrong.
//
// **Only `--sync-released` may act on it**, and that is the whole reason there
// are two spellings of one report. `--status` is a word that promises to read
// and not to write, it is what a session reaches for to find out where things
// stand, and a command that might move a ref while answering that question is
// not one you can run to look. So the report is free and the prompt is named:
// the flag *is* the asking, and a run spelled `--status` cannot write anything.
//
// The key is the App Store Connect one bin/upload-ios uploads with, read the
// same way from the same directory, for the same reason: it belongs to the team
// rather than to a person and does not expire when nobody is signed in to
// Xcode. Submissions made this way are attributed in App Store Connect to
// "API user <key id>" rather than to a name, which is how you tell later which
// ones came from here.

const fs = require('fs');
const os = require('os');
const path = require('path');
const crypto = require('crypto');
const { execFileSync } = require('child_process');

const ROOT = path.resolve(__dirname, '..');
const HOST = 'https://api.appstoreconnect.apple.com';

// ---------------------------------------------------------------- arguments

const argv = process.argv.slice(2);
const opts = {
  dryRun: false, status: false, syncReleased: false, build: null,
};
while (argv.length) {
  const arg = argv.shift();
  if (arg === '--dry-run') opts.dryRun = true;
  else if (arg === '--status') opts.status = true;
  // --sync-released is --status plus permission to ask. It reports the same
  // thing either way; the flag buys the prompt, so that a run spelled --status
  // cannot write anything and the promise in its name holds.
  else if (arg === '--sync-released') { opts.status = true; opts.syncReleased = true; }
  else if (arg === '--build') opts.build = argv.shift();
  else if (arg === '--help' || arg === '-h') {
    console.log(fs.readFileSync(__filename, 'utf8').split('\n')
      .slice(1, 10).map((l) => l.replace(/^\/\/ ?/, '')).join('\n'));
    process.exit(0);
  } else die(`unknown argument ${arg}`);
}

function die(message, ...rest) {
  console.error(`✗ ${message}`);
  for (const line of rest) console.error(`  ${line}`);
  process.exit(1);
}

// --------------------------------------------------------------------- auth

// Its own directory, and that is not tidiness: the APNs key is a `.p8` under
// ~/.config/thefloor too, both are ES256 private keys, and a glob cannot tell
// them apart by content. bin/upload-ios carries the same guard.
const ASC_DIR = process.env.THEFLOOR_ASC_DIR || path.join(os.homedir(), '.config/thefloor/asc');
const keys = fs.existsSync(ASC_DIR)
  ? fs.readdirSync(ASC_DIR).filter((f) => /^AuthKey_.+\.p8$/.test(f))
  : [];
if (keys.length === 0) die(`no App Store Connect key in ${ASC_DIR}`,
  'CREDENTIALS.md says where it lives and how to make another.');
if (keys.length > 1) die(`more than one key in ${ASC_DIR}; cannot tell which is the release key`);

const keyId = keys[0].replace(/^AuthKey_|\.p8$/g, '');
const issuerId = (process.env.APP_STORE_CONNECT_ISSUER_ID
  || fs.readFileSync(path.join(ASC_DIR, 'issuer-id'), 'utf8')).trim();

const token = (() => {
  const b64 = (o) => Buffer.from(JSON.stringify(o)).toString('base64url');
  const iat = Math.floor(Date.now() / 1000);
  const body = `${b64({ alg: 'ES256', kid: keyId, typ: 'JWT' })}.`
    + b64({ iss: issuerId, iat, exp: iat + 1200, aud: 'appstoreconnect-v1' });
  // ES256 wants the raw r||s pair; node signs DER unless told otherwise, and
  // Apple answers 401 NOT_AUTHORIZED to a DER signature without saying why.
  const sig = crypto.sign('sha256', Buffer.from(body), {
    key: fs.readFileSync(path.join(ASC_DIR, keys[0])),
    dsaEncoding: 'ieee-p1363',
  });
  return `${body}.${sig.toString('base64url')}`;
})();

async function api(method, endpoint, payload) {
  const res = await fetch(HOST + endpoint, {
    method,
    headers: {
      Authorization: `Bearer ${token}`,
      ...(payload ? { 'Content-Type': 'application/json' } : {}),
    },
    ...(payload ? { body: JSON.stringify(payload) } : {}),
  });
  const text = await res.text();
  const body = text ? JSON.parse(text) : null;
  if (!res.ok) {
    const detail = (body?.errors || []).map((e) => `${e.title}: ${e.detail}`).join('\n  ');
    die(`${method} ${endpoint} → ${res.status}`, detail || text.slice(0, 400));
  }
  return body;
}

// Every write goes through here, so --dry-run is one decision rather than one
// per call site, and so the log reads as a list of what was changed.
async function write(method, endpoint, payload, what) {
  if (opts.dryRun) {
    console.log(`  would ${what}`);
    return null;
  }
  const body = await api(method, endpoint, payload);
  console.log(`  ${what}`);
  return body;
}

// ------------------------------------------------------------------ app.json

const config = JSON.parse(fs.readFileSync(path.join(ROOT, 'app/app.json'), 'utf8')).expo;
const bundleId = config.ios.bundleIdentifier;
const version = config.version;
const buildNumber = String(opts.build || config.ios.buildNumber);

// **The version names its own text, and it is not passed in.** This was
// `--whats-new FILE` until 2026-09-20: an argument on the one run that
// matters, typed by hand, and Apple takes whatever it is handed — so the
// previous release's notes are one stale shell-history line away, and nothing
// on screen would say so. The name comes off `expo.version` instead, exactly
// as bin/set-review-notes derives the notes beside it, which is what makes a
// version bump move both texts at once.
const whatsNewFile = path.join(ROOT,
  `planning/submissions/whats-new-${version}.txt`);
const whatsNewName = path.relative(ROOT, whatsNewFile);

const main = async () => {
  console.log(`→ ${bundleId} ${version} (${buildNumber}), as API key ${keyId}`);

  const apps = await api('GET', `/v1/apps?filter[bundleId]=${bundleId}`);
  const app = apps.data[0];
  if (!app) die(`no app in App Store Connect for ${bundleId}`);
  const appId = app.id;

  const versions = (await api('GET',
    `/v1/apps/${appId}/appStoreVersions?limit=10`)).data
    .filter((v) => v.attributes.platform === 'IOS');

  if (opts.status) return status(appId, versions);

  // ------------------------------------------------------------- the build

  const builds = await api('GET', `/v1/builds?filter[app]=${appId}`
    + `&filter[version]=${buildNumber}&include=preReleaseVersion&limit=5`);
  const build = builds.data[0];
  if (!build) die(`Apple has no build ${buildNumber} for this app`,
    'The build list is the only thing that says what Apple received, as',
    'opposed to what was archived, tagged, or echoed by bin/upload-ios.');
  if (build.attributes.processingState !== 'VALID') {
    die(`build ${buildNumber} is ${build.attributes.processingState}, not VALID`,
      'Processing takes a few minutes. Nothing else here is wrong.');
  }
  const train = (builds.included || [])
    .find((i) => i.type === 'preReleaseVersions')?.attributes.version;
  if (train && train !== version) {
    die(`build ${buildNumber} was uploaded as ${train}, not ${version}`,
      'A build can only be attached to a version record whose versionString',
      'matches its own train. Crossed, the build picker is silently empty.',
      `Either bump expo.version to ${train} and upload again, or submit a`,
      'build that was uploaded under this version.');
  }
  console.log(`  build ${buildNumber} is VALID, uploaded as ${train || version}`);

  // A tag is bin/upload-ios's record that a build came from a commit. Missing,
  // the build is still perfectly submittable — it just has no revision behind
  // it, which is worth being told rather than refused.
  try {
    execFileSync('git', ['rev-parse', '--verify', `refs/tags/build/${buildNumber}`],
      { cwd: ROOT, stdio: 'ignore' });
  } catch {
    console.log(`  ⚠ no build/${buildNumber} tag; nothing records which commit this is`);
  }

  // ----------------------------------------------------- the version record

  const EDITABLE = new Set([
    'PREPARE_FOR_SUBMISSION', 'DEVELOPER_REJECTED', 'REJECTED',
    'METADATA_REJECTED', 'INVALID_BINARY',
  ]);

  let record = versions.find((v) => v.attributes.versionString === version);
  if (record && !EDITABLE.has(record.attributes.appStoreState)) {
    die(`${version} is ${record.attributes.appStoreState}, which is not editable`,
      'A version already in front of review, or released, cannot take another',
      'build. Bump expo.version, upload, and run this again — or withdraw the',
      'submission in App Store Connect if that is what you meant.');
  }

  if (!record) {
    // Copyright and release type are copied from the newest version rather
    // than invented: they carry forward untouched in the UI, and a version
    // record created without them reads as a regression nobody made.
    const previous = versions[0]?.attributes || {};
    console.log(`→ no version record for ${version}`);
    const created = await write('POST', '/v1/appStoreVersions', {
      data: {
        type: 'appStoreVersions',
        attributes: {
          platform: 'IOS',
          versionString: version,
          copyright: previous.copyright || null,
          releaseType: previous.releaseType || 'MANUAL',
        },
        relationships: { app: { data: { type: 'apps', id: appId } } },
      },
    }, `created version ${version} (${previous.releaseType || 'MANUAL'} release)`);
    if (opts.dryRun) {
      console.log('  stopping: everything below needs the version record');
      return;
    }
    record = created.data;
  } else {
    console.log(`→ version ${version} is ${record.attributes.appStoreState}`);
  }
  const versionId = record.id;

  // ------------------------------------------------------ the build, attached

  const attached = (await api('GET', `/v1/appStoreVersions/${versionId}/build`)).data;
  if (attached?.id === build.id) {
    console.log(`  build ${buildNumber} already attached`);
  } else {
    if (attached) {
      console.log(`  ⚠ replacing build ${attached.attributes.version}, already attached`);
    }
    await write('PATCH', `/v1/appStoreVersions/${versionId}/relationships/build`,
      { data: { type: 'builds', id: build.id } }, `attached build ${buildNumber}`);
  }

  // ---------------------------------------------------------- what's new

  const locales = (await api('GET',
    `/v1/appStoreVersions/${versionId}/appStoreVersionLocalizations`)).data;
  // A missing file is reported and not fatal, because writing the field in
  // App Store Connect is still a way to have one — the error below is where
  // *nothing anywhere* has it, which is the failure this section exists for.
  // An empty file is fatal: it is somebody having meant to write the text.
  let text = null;
  if (fs.existsSync(whatsNewFile)) {
    text = fs.readFileSync(whatsNewFile, 'utf8').trim();
    if (!text) die(`${whatsNewName} is empty`);
    if (text.length > 4000) {
      die(`${whatsNewName} is ${text.length} characters; the cap is 4,000`,
        'There is no larger field. RELEASING.md § *Writing "What\'s New"*.');
    }
  } else {
    console.log(`  no ${whatsNewName}`);
  }
  for (const locale of locales) {
    const current = (locale.attributes.whatsNew || '').trim();
    if (text && text !== current) {
      await write('PATCH', `/v1/appStoreVersionLocalizations/${locale.id}`, {
        data: {
          type: 'appStoreVersionLocalizations',
          id: locale.id,
          attributes: { whatsNew: text },
        },
      }, `set What's New for ${locale.attributes.locale} (${text.length} characters)`);
    } else if (!current && !text) {
      die(`What's New is empty for ${locale.attributes.locale}`,
        'It is the one listing field an update must have and a first',
        'submission does not, so it is the one that gets forgotten.',
        `Write ${whatsNewName}, or write it in App Store Connect.`);
    } else {
      console.log(`  What's New for ${locale.attributes.locale} left as it is`
        + ` (${current.length} characters)`);
    }
  }

  // -------------------------------------------------------- review details

  const detail = (await api('GET',
    `/v1/appStoreVersions/${versionId}/appStoreReviewDetail`)).data;
  checkReviewDetail(detail);

  // ------------------------------------------------------- the submission

  const open = (await api('GET',
    `/v1/apps/${appId}/reviewSubmissions?filter[state]=READY_FOR_REVIEW`)).data;
  let submission = open[0];
  if (submission) {
    console.log(`→ reusing the submission already open (${submission.id})`);
  } else {
    const created = await write('POST', '/v1/reviewSubmissions', {
      data: {
        type: 'reviewSubmissions',
        attributes: { platform: 'IOS' },
        relationships: { app: { data: { type: 'apps', id: appId } } },
      },
    }, 'opened a submission');
    if (opts.dryRun) return finish(appId, versionId, null);
    submission = created.data;
  }

  const items = (await api('GET',
    `/v1/reviewSubmissions/${submission.id}/items?include=appStoreVersion`)).data;
  const mine = items.find((i) => i.relationships?.appStoreVersion?.data?.id === versionId);
  const others = items.filter((i) => i !== mine);
  if (others.length) {
    console.log(`  ⚠ this submission also holds ${others.length} other item(s);`
      + ' Submit sends all of them');
  }
  if (mine) {
    console.log(`  version ${version} is already an item on it`);
  } else {
    await write('POST', '/v1/reviewSubmissionItems', {
      data: {
        type: 'reviewSubmissionItems',
        relationships: {
          reviewSubmission: { data: { type: 'reviewSubmissions', id: submission.id } },
          appStoreVersion: { data: { type: 'appStoreVersions', id: versionId } },
        },
      },
    }, `added version ${version} to it`);
  }

  finish(appId, versionId, submission.id);
};

// The four settings on the box a reviewer meets are in RELEASING.md; these are
// the four fields in App Store Connect that pair with them. Missing, the
// submission is taken and the review fails at the sign-in screen a day later.
function checkReviewDetail(detail) {
  const a = detail?.attributes || {};
  const missing = [];
  if (!detail) missing.push('there are no review details at all');
  if (!a.contactEmail) missing.push('contact email');
  if (!a.notes) missing.push('review notes');
  if (a.demoAccountRequired && !(a.demoAccountName && a.demoAccountPassword)) {
    missing.push('demo account credentials');
  }
  if (missing.length) {
    die(`the review details are incomplete: ${missing.join(', ')}`,
      'App Review Information in App Store Connect. DEMO-ACCOUNT.md has the',
      'accounts and RELEASING.md what the notes have carried before.');
  }
  if (!a.demoAccountRequired) {
    console.log('  ⚠ review details say no demo account is required;'
      + ' a reviewer who cannot sign in sees an app that does nothing');
    return;
  }

  // The credentials are published in the notes the moment they are sent, and
  // they go stale quietly: DEMO-ACCOUNT.md's copy is the live one.
  const file = path.join(os.homedir(), '.config/thefloor/demo-account.txt');
  if (!fs.existsSync(file)) {
    console.log(`  review details name ${a.demoAccountName};`
      + ` ${file} is absent, so nothing checked it`);
    return;
  }
  const contents = fs.readFileSync(file, 'utf8');
  const matches = contents.includes(a.demoAccountName)
    && contents.includes(a.demoAccountPassword);
  if (matches) {
    console.log(`  review details sign in as ${a.demoAccountName}, which`
      + ' demo-account.txt agrees with');
  } else {
    console.log(`  ⚠ review details sign in as ${a.demoAccountName}, which is`
      + ` not what ${file} says. One of the two is stale — check before`
      + ' submitting, since a reviewer who cannot sign in is a rejection.');
  }
}

function finish(appId, versionId, submissionId) {
  const page = `https://appstoreconnect.apple.com/apps/${appId}/distribution/ios/version/inflight`;
  console.log('');
  console.log('✓ prepared, and not submitted.');
  console.log('');
  console.log('  Everything above is editable or deletable. What is left is the');
  console.log('  irreversible half, and it is a person\'s to do:');
  console.log('');
  console.log(`    ${page}`);
  console.log('');
  console.log('  Read the page, choose whether this update gets a phased release,');
  console.log('  and press "Add for Review" / "Submit to App Review".');
  console.log('');
  console.log('  Before pressing it, RELEASING.md § *To verify before pressing');
  console.log('  submit* is the list nothing here can check — App Privacy above');
  console.log('  all, which has no API and is app-level rather than version-level.');
  if (submissionId) {
    console.log('');
    console.log(`  The submission is ${submissionId}; bin/submit-ios --status`);
    console.log('  reports what Apple thinks of it afterwards, which the UI is a');
    console.log('  poor witness to.');
  }
}


// --status exists because the UI is a poor witness to what state a submission
// is in, and the API answers in a second. Read-only, always — of Apple, and of
// this checkout. `offer` below is false unless somebody spelled
// --sync-released, which is the only way anything here writes.
async function status(appId, versions) {
  const rows = [];
  for (const v of versions) {
    const attached = (await api('GET', `/v1/appStoreVersions/${v.id}/build`)).data;
    rows.push({
      version: v.attributes.versionString,
      state: v.attributes.appStoreState,
      build: attached?.attributes.version ?? null,
    });
    console.log(`  ${v.attributes.versionString.padEnd(8)}`
      + `${v.attributes.appStoreState.padEnd(24)}`
      + `build ${attached?.attributes.version ?? '—'}`);
  }
  const submissions = (await api('GET',
    `/v1/apps/${appId}/reviewSubmissions?limit=5`)).data;
  const open = (await api('GET',
    `/v1/apps/${appId}/reviewSubmissions?filter[state]=READY_FOR_REVIEW`)).data;
  console.log('');
  for (const s of [...open, ...submissions]) {
    const when = s.attributes.submittedDate
      ? new Date(s.attributes.submittedDate).toISOString().slice(0, 16).replace('T', ' ')
      : 'not submitted';
    console.log(`  ${s.attributes.state.padEnd(24)}${when}   ${s.id}`);
  }
  console.log('');
  console.log('  WAITING_FOR_REVIEW with a fresh date is what a submission that');
  console.log('  worked looks like. UNRESOLVED_ISSUES with an old one is a');
  console.log('  rejection nobody has answered yet.');

  await reconcileReleased(rows, opts.syncReleased);
}

// ----------------------------------------------------------- the released ref

// `released` says which build is downloadable, and what is downloadable is a
// state Apple holds rather than anything a ref can derive — so the two drift
// silently, and nothing in git knows it. The cost is not abstract:
// `bin/deploy-web --stable` is cut from `released`, so a stale ref re-ships the
// *previous* release and reports success. This is the one command with both
// halves on screen at once, so it is the one place that can say they disagree.
//
// **It offers rather than moves, and only under --sync-released.** Moving
// `released` is the record that a build is in people's hands, and deciding that
// is a person's — the same seam the Submit button is on, and the same rule as
// landing and deploying. Both the flag and the "y" are the asking; without the
// flag, or without a terminal to ask at, it prints the command and writes
// nothing, because a script is not somebody asking either.
async function reconcileReleased(rows, offer) {
  // Every version that ever shipped stays READY_FOR_SALE — the list above is
  // seven of them — so "the downloadable one" is the newest of those, and the
  // newest is chosen by build number rather than by the order Apple listed
  // them in. Taking the first row would be right today and silently wrong the
  // day that ordering changes.
  const live = rows
    .filter((r) => r.state === 'READY_FOR_SALE')
    .sort((a, b) => Number(b.build || 0) - Number(a.build || 0))[0];
  const here = (git('describe', '--tags', 'released') || '')
    .match(/^build\/(\d+)/)?.[1] || null;

  // Approved and not yet released: the one state in which `released` is
  // *correctly* behind, and the moment before somebody presses the button.
  const pending = rows.find((r) => r.state === 'PENDING_DEVELOPER_RELEASE');
  if (pending) {
    console.log('');
    console.log(`  ${pending.version} (build ${pending.build ?? '—'}) is approved and waiting for you`);
    console.log('  to release it. released is meant to be behind until you do — it');
    console.log('  moves on release, not on approval.');
  }

  if (!live) {
    if (here) {
      console.log('');
      console.log(`  Nothing is READY_FOR_SALE; released points at build/${here},`);
      console.log('  which is whatever was downloadable before. Left alone.');
    }
    return;
  }
  if (!live.build) {
    console.log('');
    console.log(`  ${live.version} is READY_FOR_SALE with no build attached, which`);
    console.log('  Apple should not allow — released cannot be reconciled from it.');
    return;
  }
  if (here === live.build) {
    console.log('');
    console.log(`  released points at build/${here}, which is what App Store Connect`);
    console.log(`  says is downloadable (${live.version}). In sync.`);
    return;
  }

  console.log('');
  console.log('  ⚠ released is out of sync with what is downloadable.');
  console.log(`      App Store Connect:  ${live.version} is READY_FOR_SALE, build ${live.build}`);
  console.log(`      this checkout:      released → ${here ? `build/${here}` : 'no such ref'}`);

  // Only the machine that ran bin/upload-ios has the build tag, and tags are
  // not pushed automatically — so on any other checkout the target of the move
  // simply is not here, and saying that is more use than failing at git.
  if (!git('rev-parse', '--verify', `refs/tags/build/${live.build}`)) {
    console.log('');
    console.log(`  There is no build/${live.build} tag in this checkout, so there is`);
    console.log('  nothing to point released at. bin/upload-ios writes that tag on');
    console.log('  the machine that uploaded, and tags are not pushed automatically.');
    return;
  }

  const command = `git tag -f released build/${live.build}`;
  if (!offer) {
    console.log('');
    console.log(`  To reconcile:  ${command}`);
    console.log('  — or bin/submit-ios --sync-released, which asks first and then');
    console.log('  runs exactly that. Either way bin/deploy-web --stable comes');
    console.log('  after, never before: it is cut from released, so running it');
    console.log('  first re-ships the previous release and says nothing is wrong.');
    return;
  }
  if (!(process.stdin.isTTY && process.stdout.isTTY)) {
    console.log('');
    console.log(`  Nothing to ask with — no terminal. To reconcile:  ${command}`);
    return;
  }

  console.log('');
  const answer = await ask(`  Move released to build/${live.build}? [y/N] `);
  if (!/^y(es)?$/i.test(answer.trim())) {
    console.log(`  Left alone. The command, when you mean it:  ${command}`);
    return;
  }

  // `git tag -f`, and the target spelled as the tag name: released is a
  // lightweight ref pointing at the build/<n> *tag object*, which is what
  // `git describe` reads back. `-a` makes a second annotated tag instead, and
  // spelling the target `build/<n>^{}` peels to the commit and loses the
  // description — both look like they worked.
  if (git('tag', '-f', 'released', `build/${live.build}`) === null) {
    die(`${command} failed`, 'Nothing was moved.');
  }
  console.log(`  released → ${git('describe', '--tags', 'released')}`);
  console.log('');
  console.log('  Next, in this order: bin/deploy-web --stable, which is cut from');
  console.log('  released and would have re-shipped the previous release a moment');
  console.log('  ago. The ref stays local; there is nothing to push.');
}

function git(...args) {
  try {
    return execFileSync('git', args, {
      cwd: ROOT, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();
  } catch {
    return null;
  }
}

function ask(question) {
  const rl = require('readline').createInterface({
    input: process.stdin, output: process.stdout,
  });
  return new Promise((resolve) => rl.question(question, (answer) => {
    rl.close();
    resolve(answer);
  }));
}

main();
