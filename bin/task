#!/bin/bash
#
# A new task, which is the common case and so has its own name.
#
#   bin/task "Some Title"
#
# Creates planning/tasks/<slug>.md holding that title as its `# ` heading, and
# prints the path. Writing what the task actually is remains yours; a file
# holding nothing but a heading is a real state, and says the work is wanted
# and that nobody has yet said what it is.
#
# Everything else — finding which file a quoted reference means, retitling one,
# the backlog, decisions, the invariants — is `bin/note`, which is also where
# the slug rule is implemented. This is that tool's most-typed line and nothing
# more.

set -euo pipefail
exec "$(dirname "${BASH_SOURCE[0]}")/note" new tasks "$@"
