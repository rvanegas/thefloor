{
  "name": "@thefloor/server",
  "version": "1.0.0",
  "private": true,
  "description": "Authoritative session server. Imports core/ so the floor rules have one implementation.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "build:web": "node web/build.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/client-sesv2": "^3.1103.0",
    "@fastify/websocket": "^11.0.2",
    "@livekit/rtc-node": "^0.13.33",
    "fastify": "^5.2.1",
    "livekit-server-sdk": "^2.17.0",
    "tsx": "^4.23.6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "livekit-client": "^2.22.0",
    "ts-jest": "^29.2.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 15000,
    "moduleNameMapper": {
      "^@livekit/rtc-node$": "<rootDir>/__stubs__/rtc-node.ts"
    }
  }
}
